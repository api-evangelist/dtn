          "item": [
            {
              "name": "Get current weather conditions",
              "id": "c14ffd7e-e99b-481c-86ba-637aaa573c61",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/v2/current?locatedAt=<string>&fields=<string>&units=SI",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v2",
                    "current"
                  ],
                  "query": [
                    {
                      "description": "(Required) Location specification. Format: latitude,longitude (e.g., 40.7128,-74.0060) or meteoGroupStationId (e.g., KMSP for Minneapolis-St. Paul)",
                      "key": "locatedAt",
                      "value": "<string>"
                    },
                    {
                      "description": "Comma-separated list of weather fields to return",
                      "key": "fields",
                      "value": "<string>"
                    },
                    {
                      "description": "Unit system for returned values",
                      "key": "units",
                      "value": "SI"
                    }
                  ]
                },
                "description": "Returns current weather conditions for a specified location using latitude/longitude or a weather station identifier. Supports unit selection (US customary or SI)."
              },
              "response": [
                {
                  "id": "9cb893c8-d2fe-41fe-9da0-63e607023754",
                  "name": "Current weather conditions",
