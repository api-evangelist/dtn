{
  "info": {
    "_postman_id": "d352865d-0adf-46f1-baeb-8199a383078b",
    "name": "DTN Weather Conditions API",
    "description": "DTN Weather Conditions API delivers worldwide forecast, current condition, and historical weather data. The API leverages cloud technology and global forecast models to provide validated, continuously calibrated weather data. Supports geospatial queries, time-based filtering, and multi-station requests. Authentication uses OAuth2 Client Credentials; access tokens are obtained from auth.weather.mg/oauth/token and used as Bearer tokens.\n\nContact Support:\n Name: DTN Weather API Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-08-03T11:20:31.000Z",
    "updatedAt": "2026-08-03T11:20:32.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-d352865d-0adf-46f1-baeb-8199a383078b"
  },
