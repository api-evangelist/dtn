          "info": {
            "name": "Sun and Moon",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://astronomical.api.dtn.com/v2/sun-moon",
            "headers": [
              {
                "name": "Accept-Encoding",
                "value": ""
              },
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "lat",
                "value": "52.369",
                "type": "query"
              },
              {
                "name": "lon",
                "value": "4.875",
                "type": "query"
              },
              {
                "name": "startDate",
                "value": "2023-08-10",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "2023-08-12",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api.auth.dtn.com/v1/tokens/authorize",
