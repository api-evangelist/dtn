          "id": "a42bb89a-ce03-42b2-b756-b3bbb031a75a",
          "name": "Get Lightning Strikes",
          "request": {
            "name": "Get Lightning Strikes",
            "description": {
              "content": "This endpoint allows users to retrieve all lightning strikes that match the set criteria.\n#### NOTES:\n  - Space: Observations can be searched geographically by:\n    - `radius` required parameters: `lat`, `lon` and `radius`\n    - `boundingBox` required parameters: `minLat`, `minLon`, `maxLat` and `maxLon`\n  - Time: To search within a time window:\n    - For time range, provide `startTime` and `endTime`. All should be in `ISO` format. Maximum time range is 2 weeks.\n    - If only `startTime` or `endTime` is provided, the missing one will be calculated by the maximum time range allowable.\n    - If neither `startTime` and `endTime` are provided, the most recent strikes from the last maximum time range will be fetched.\n  - Filter: Providing `parameters` enables you to filter which parameters will be included in the response.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "strikes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "by",
                  "value": "<string>",
                  "description": "(Required) Get observations by radius | boundingBox."
                },
                {
                  "disabled": false,
                  "key": "radius",
                  "value": "<number>",
                  "description": "Radius for radial search in km."
                },
                {
                  "disabled": false,
